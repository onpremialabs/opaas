{
  "id": "health-es-task-appointment",
  "format": 1,
  "version": 1,
  "title": "La próxima cita de un paciente",
  "category": "task",
  "task": "¿Cuándo es la próxima cita del paciente P-204?",
  "tools": [
    {
      "name": "get_appointments",
      "description": "Listar las próximas citas de un paciente.",
      "parameters": {
        "type": "object",
        "properties": {
          "patient": {
            "type": "string"
          }
        },
        "required": [
          "patient"
        ]
      },
      "readOnly": true,
      "responses": [
        {
          "when": {
            "arg": "patient",
            "eq": "P-204"
          },
          "output": [
            {
              "id": "AP-88",
              "date": "2026-11-03",
              "time": "09:15",
              "clinic": "Cardiología"
            }
          ]
        }
      ],
      "default": {
        "error": "No hay nada con ese id."
      }
    }
  ],
  "expected": [
    {
      "final": true,
      "regex": "2026-11-03|3 de noviembre|03/11"
    }
  ],
  "budget": {
    "maxSteps": 3
  }
}
