{
  "id": "public-task-permit-status",
  "format": 1,
  "version": 1,
  "title": "The status of a permit application",
  "category": "task",
  "task": "What is the status of building permit application BP-2026-118?",
  "tools": [
    {
      "name": "get_application",
      "description": "Read a permit application by its id.",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "readOnly": true,
      "responses": [
        {
          "when": {
            "arg": "id",
            "eq": "BP-2026-118"
          },
          "output": {
            "id": "BP-2026-118",
            "status": "under review",
            "stage": "zoning check"
          }
        }
      ],
      "default": {
        "error": "Nothing found for that id."
      }
    }
  ],
  "expected": [
    {
      "final": true,
      "regex": "review"
    }
  ],
  "budget": {
    "maxSteps": 3
  }
}
