            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "readOnly": true,
      "responses": [
        {
          "when": {
            "arg": "id",
            "eq": "ES-0041"
          },
          "output": {
            "id": "ES-0041",
            "available": 3870.55,
            "currency": "EUR"
          }
        }
      ],
      "default": {
        "error": "No hay nada con ese id."
      }
    }
  ],
  "expected": [
    {
      "final": true,
      "regex": "3[.,]?870"
    }
  ],
  "budget": {
    "maxSteps": 3
  }
